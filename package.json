    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.0.0"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "postcss": "$postcss",
    "@next/eslint-plugin-next": {
      "glob": "^10.5.0"
    },
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
