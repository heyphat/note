{
  "name": "note",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first markdown notebook that runs in your browser, writes plain .md files to a folder you choose, and brings your own AI key.",
  "license": "MIT",
  "author": "Phat Huynh",
  "homepage": "https://github.com/heyphat/note#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyphat/note.git"
  },
  "bugs": {
    "url": "https://github.com/heyphat/note/issues"
  },
  "keywords": [
    "markdown",
    "notes",
    "note-taking",
    "local-first",
    "wysiwyg",
    "editor",
    "milkdown",
    "file-system-access-api",
    "wikilinks",
    "zettelkasten",
    "pkm",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "conform:tasknotes": "vitest run src/lib/tasks/conformance-adapter.test.ts",
    "build:docs": "node scripts/build-docs-bundle.mjs",
    "predev": "node scripts/build-docs-bundle.mjs",
    "prebuild": "node scripts/build-docs-bundle.mjs"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.66",
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/google": "^4.0.54",
    "@ai-sdk/google-vertex": "^5.0.66",
    "@ai-sdk/openai": "^4.0.50",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@milkdown/crepe": "^7.22.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "@xyflow/react": "^12.11.5",
    "ai": "^7.0.83",
    "diff": "^9.0.0",
    "google-auth-library": "^10.0.0",
    "lightweight-charts": "5.2.1",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.14.0",
    "minisearch": "^7.2.0",
    "next": "15.5.24",
    "next-intl": "^4.9.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^18",
    "react-day-picker": "^9.14.0",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10",
    "eslint-config-next": "15.5.24",
    "jsdom": "^30.0.1",
    "postcss": "^8",
