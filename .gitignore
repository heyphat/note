# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
# This project uses npm (package-lock.json). A committed pnpm-lock.yaml
# would make Vercel flip to pnpm strict mode and break transitive imports.
/pnpm-lock.yaml

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated — `public/docs-bundle/` is rebuilt from `docs/` by
# scripts/build-docs-bundle.mjs on every predev/prebuild, so nothing
# under public/ is source.
/public

# Per-note revision snapshots the app writes into a vault at runtime. The
# bundled docs vault under docs/ is authored in Note itself, so these appear
# there; they're never served (build-docs-bundle.mjs skips dotdirs other than
# .assets) and shouldn't be committed.
docs/*/.history/

# local scratch data
/data
*.csv

# editor / tooling local state
.claude/settings.local.json